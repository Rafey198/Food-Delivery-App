{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npm install --no-audit --no-fund && npm run db:generate && cd apps/web && next build",
  "installCommand": "echo 'install handled by buildCommand'",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@food_api_url",
    "NEXT_PUBLIC_WS_URL": "@food_ws_url",
    "NEXT_PUBLIC_MAPBOX_TOKEN": "@food_mapbox_token"
  }
}
