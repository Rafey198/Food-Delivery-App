# ---------- Database ----------
DATABASE_URL="postgresql://food:food@localhost:5432/food?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- API ----------
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---------- Auth ----------
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------- Payments (Stripe) ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- AI ----------
OPENAI_API_KEY=""
AI_PROVIDER="mock" # mock | openai

# ---------- Storage (S3-compatible) ----------
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="food-delivery"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ---------- Maps ----------
MAPBOX_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ---------- Email / SMS / Push (placeholders) ----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER="mock"
PUSH_PROVIDER="mock"
